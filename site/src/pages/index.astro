<script>
  type Item = {
    slug: string;
    title: string;
    type: string;
    body: string;
    image: string;
    fallback: string;
    href: string;
    installPrompt: string;
  };

  const dataEl = document.getElementById("ext-data");
  const items: Item[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

  const overlay = document.getElementById("lightbox");
  const imgEl = document.getElementById("lb-img") as HTMLImageElement | null;
  const titleEl = document.getElementById("lb-title");
  const badgeEl = document.getElementById("lb-badge");
  const descEl = document.getElementById("lb-desc");
  const promptEl = document.getElementById("lb-prompt");
  const copyEl = document.getElementById("lb-copy");
  const ghEl = document.getElementById("lb-gh") as HTMLAnchorElement | null;
  const countEl = document.getElementById("lb-count");
  const closeEl = document.getElementById("lb-close") as HTMLElement | null;

  const zoomOverlay = document.getElementById("img-zoom-overlay");
  const zoomTarget = document.getElementById("img-zoom-target") as HTMLImageElement | null;
  const zoomToggle = document.getElementById("img-zoom-toggle");
  const zoomRaw = document.getElementById("img-zoom-raw") as HTMLAnchorElement | null;
  const zoomClose = document.getElementById("img-zoom-close") as HTMLElement | null;

  let current = 0;
  let lastFocus: HTMLElement | null = null;
  let zoomLastFocus: HTMLElement | null = null;

  function openFullImage(src: string, alt = "Full-size image") {
    if (!zoomOverlay || !zoomTarget) return;
    zoomLastFocus = document.activeElement as HTMLElement;
    zoomTarget.src = src;
    zoomTarget.alt = alt;
    zoomTarget.classList.remove("is-actual-size");
    if (zoomToggle) zoomToggle.textContent = "1:1 Actual Size";
    if (zoomRaw) zoomRaw.href = src;
    zoomOverlay.hidden = false;
    document.body.style.overflow = "hidden";
    zoomClose?.focus();
  }

  function closeFullImage() {
    if (!zoomOverlay) return;
    zoomOverlay.hidden = true;
    if (!overlay || overlay.hidden) {
      document.body.style.overflow = "";
    }
    zoomLastFocus?.focus?.();
  }

  function toggleActualSize() {
    if (!zoomTarget) return;
    const isActual = zoomTarget.classList.toggle("is-actual-size");
    if (zoomToggle) {
      zoomToggle.textContent = isActual ? "Fit to Screen" : "1:1 Actual Size";
    }
  }

  function populate(i: number) {
    const it = items[i];
    if (!it) return;
    current = i;
    if (imgEl) {
      imgEl.style.opacity = "0";
      imgEl.onerror = () => {
        imgEl.onerror = null;
        imgEl.src = it.fallback;
      };
      imgEl.src = it.image;
      imgEl.alt = `${it.slug} screenshot`;
      requestAnimationFrame(() => {
        imgEl.style.opacity = "1";
      });
    }
    if (titleEl) titleEl.textContent = it.title;
    if (badgeEl) badgeEl.textContent = it.type;
    if (descEl) descEl.textContent = it.body;
    if (promptEl) promptEl.textContent = it.installPrompt;
    if (copyEl) copyEl.setAttribute("data-copy", it.installPrompt);
    if (ghEl) ghEl.href = it.href;
    if (countEl) countEl.textContent = `${i + 1} / ${items.length}`;
  }

  function openAt(i: number) {
    if (!overlay) return;
    lastFocus = document.activeElement as HTMLElement;
    populate(i);
    overlay.hidden = false;
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    closeEl?.focus();
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lastFocus?.focus?.();
  }

  function go(delta: number) {
    if (!items.length) return;
    populate((current + delta + items.length) % items.length);
  }

  async function copyText(btn: HTMLElement) {
    const text = btn.getAttribute("data-copy") ?? "";
    const label = btn.querySelector<HTMLElement>(".copy-label");
    const original = label?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
    if (label) label.textContent = "Copied!";
    btn.classList.add("copied");
    window.setTimeout(() => {
      if (label) label.textContent = original;
      btn.classList.remove("copied");
    }, 1500);
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    if (target.closest("#img-zoom-close")) return closeFullImage();
    if (target.closest("#img-zoom-toggle") || target === zoomTarget) return toggleActualSize();
    if (zoomOverlay && !zoomOverlay.hidden && (target === zoomOverlay || target.id === "img-zoom-stage")) {
      return closeFullImage();
    }

    const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
    if (fullImgTrigger) {
      const src = fullImgTrigger.getAttribute("data-full-img");
      const img = fullImgTrigger.querySelector("img");
      if (src) openFullImage(src, img?.alt || "Full-size image");
      return;
    }

    if (target.closest("#lb-media-wrap") && imgEl?.src) {
      openFullImage(imgEl.src, imgEl.alt || "Full-size image");
      return;
    }

    const copyBtn = target.closest<HTMLElement>("[data-copy]");
    if (copyBtn) {
      copyText(copyBtn);
      return;
    }

    if (target.closest("#lb-close")) return close();
    if (target.closest("#lb-prev")) return go(-1);
    if (target.closest("#lb-next")) return go(1);
    if (overlay && !overlay.hidden && target === overlay) return close();

    const card = target.closest<HTMLElement>("[data-card]");
    if (card) {
      const idx = Number(card.getAttribute("data-index"));
      if (!Number.isNaN(idx)) openAt(idx);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (zoomOverlay && !zoomOverlay.hidden) {
      if (event.key === "Escape") return closeFullImage();
      return;
    }
    if (overlay && !overlay.hidden) {
      if (event.key === "Escape") return close();
      if (event.key === "ArrowLeft") return go(-1);
      if (event.key === "ArrowRight") return go(1);
      return;
    }
    const target = event.target as HTMLElement;
    const fullImgTrigger = target.closest<HTMLElement>("[data-full-img]");
    if ((event.key === "Enter" || event.key === " ") && fullImgTrigger) {
      event.preventDefault();
      const src = fullImgTrigger.getAttribute("data-full-img");
      const img = fullImgTrigger.querySelector("img");
      if (src) openFullImage(src, img?.alt || "Full-size image");
      return;
    }
    if (
      (event.key === "Enter" || event.key === " ") &&
      target.closest("[data-card]") &&
      !target.closest("[data-copy]")
    ) {
      event.preventDefault();
      const card = target.closest<HTMLElement>("[data-card]")!;
      const idx = Number(card.getAttribute("data-index"));
      if (!Number.isNaN(idx)) openAt(idx);
    }
  });
</script>

