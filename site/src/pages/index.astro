                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-allmerged.png`} role="button" tabindex="0" aria-label="View All Merged Pill up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-allmerged.png`} alt="Up-close screenshot of purple all-merged subagent pill" loading="lazy" />
                      </div>
                      <code>All Merged Pill</code>
                      <span>Turns purple when every subagent PR has merged (0 starting, 0 in PR) and dismisses on your next prompt</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
          <div class={`grid${groupItems.length === 1 ? " grid-solo" : ""}`}>
            {groupItems.map((it) => (
              <Card
                title={it.title}
                tag={it.type}
                index={it.index}
                image={it.image}
                imageAlt={`${it.slug} screenshot`}
                fallback={it.fallback}
                installPrompt={it.installPrompt}
              >
                {it.body}
              </Card>
            ))}
          </div>
        </section>
      );
    })
  }

  <section style="margin-top: 3rem; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
    <h2 style="margin: 0 0 0.75rem; font-size: 1.25rem;">Install one</h2>
    <p style="margin: 0 0 0.75rem; color: var(--muted);">
      Install from inside Copilot in the app or the CLI: just ask the agent (or
      click the copy icon on any extension code block above and paste it into Copilot):
    </p>
    <div class="code-block">
