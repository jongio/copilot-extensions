                      <code>N in PR</code>
                      <span>PR icon counter for subagents with an open pull request under review or CI</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-merged.png`} role="button" tabindex="0" aria-label="View Merged Counter up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-merged.png`} alt="Up-close screenshot of merged subagent PR counter token" loading="lazy" />
                      </div>
                      <code>N merged</code>
                      <span>Merge icon counter for subagents whose pull requests have landed</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-failed.png`} role="button" tabindex="0" aria-label="View Failed Counter up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-failed.png`} alt="Up-close screenshot of failed subagent counter token" loading="lazy" />
