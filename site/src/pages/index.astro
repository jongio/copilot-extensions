---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const repo = "https://github.com/jongio/copilot-extensions";
const base = import.meta.env.BASE_URL;
const fallback = `${base}screenshots/placeholder.svg`;

const installPromptFor = (slug: string, type: string) =>
  type === "Canvas"
    ? `install the ${slug} canvas from jongio/copilot-extensions/extensions/${slug}`
    : `install the ${slug} extension from jongio/copilot-extensions/extensions/${slug} and run its installer`;

const meta: Record<string, { type: string; body: string }> = {
  "pr-statusline": {
    type: "CLI statusline",
    body: "Live, color-coded PR status pills in the Copilot CLI footer for every PR this session is working on across repos and worktrees, with clickable owner/repo#number links, CI check progress (passed/total), approvals (approved/total), resolved review comments (resolved/total), and a purple Merged badge that dismisses on your next input.",
  },
  "issue-statusline": {
    type: "CLI statusline",
    body: "Separate clickable issue pills in the Copilot CLI footer for every GitHub issue this session is working on, with priority/bug badges, linked-PR indicators, assignees, comment counts, and a purple Closed badge that dismisses on your next input.",
  },
  "subagent-statusline": {
    type: "CLI statusline",
    body: "Live subagent state counter pill (starting, in PR, merged, failed) for the active Copilot CLI session. When all subagent PRs merge, the pill turns purple and dismisses on your next input.",
  },
  "code-tutor": {
    type: "Canvas",
    body: "Turns the current codebase into a personal CS course: extracts the algorithms, data structures, complexity and theory in your code, explains each at an adjustable level (ELI5 to Wizard), points at real files with syntax-highlighted code, tracks what you understand, and reviews good/ok/bad spots with a path to fix them.",
  },
  "language-tutor": {
    type: "Canvas",
    body: "Pick a language and a gamified course appears — flashcards, quizzes, XP, levels, streaks, hearts, gems, mascots and confetti, plus AI example sentences for any word. You and the agent share one learner profile.",
  },
  "stock-ticker": {
    type: "Canvas",
    body: "A personalized live stock watchlist — shared between you and the agent, with live quotes, sparklines, and an AI market summary of what's moving.",
  },
  "news-aggregator": {
    type: "Canvas",
    body: "Pick a topic or free-text search and get a live, shared news feed (Google News, no API key). Save/favorite/hide items, search history, pin searches as custom topics, sort & filter, visible-only auto-refresh — plus a one-tap AI TL;DR digest of the current headlines.",
  },
  "wiki-discover": {
    type: "Canvas",
    body: "A \u201Cfor you\u201D Wikipedia reader shared with the agent — pick interests (or thumbs up / meh / not-for-me each article) and it learns your topics and surfaces popular articles you'll find interesting, with article images, a live preference profile, and an AI TL;DR per article.",
  },
  "random-animal": {
    type: "Canvas",
    body: "Roll the dice to discover a random animal and a fun fact — with bounce-in animations, floating emojis, roll history, and a \u201CTell me more\u201D AI fun fact.",
  },
};

const groups = [
  {
    title: "Copilot CLI Statuslines",
    blurb:
      "Composable terminal statuslines for GitHub Copilot CLI that track active session Pull Requests, GitHub Issues, and Subagents side-by-side.",
    slugs: ["pr-statusline", "issue-statusline", "subagent-statusline"],
  },
  {
    title: "Tutors",
    blurb: "Learn by doing: leveled, gamified tutors that adapt to you.",
    slugs: ["code-tutor", "language-tutor"],
  },
  {
    title: "Live & discover",
    blurb:
      "Shared, auto-refreshing dashboards and a personalized discovery feed.",
    slugs: ["stock-ticker", "news-aggregator", "wiki-discover"],
  },
  {
    title: "Just for fun",
    blurb: "A little delight, on demand.",
    slugs: ["random-animal"],
  },
];

// Flatten in group order so each card gets a stable global index the lightbox
// navigates by (code-tutor first).
type Item = {
  slug: string;
  group: string;
  title: string;
  type: string;
  body: string;
  image: string;
  fallback: string;
  href: string;
  installPrompt: string;
  index: number;
};

const items: Item[] = [];
for (const g of groups) {
  for (const slug of g.slugs) {
    const m = meta[slug];
    items.push({
      slug,
      group: g.title,
      title: slug,
      type: m.type,
      body: m.body,
      image: `${base}screenshots/${slug}.png`,
      fallback,
      href: `${repo}/tree/main/extensions/${slug}`,
      installPrompt: installPromptFor(slug, m.type),
      index: items.length,
    });
  }
}

// Slim payload the client lightbox reads (drop server-only fields).
const clientData = items.map(({ slug, title, type, body, image, fallback, href, installPrompt }) => ({
  slug,
  title,
  type,
  body,
  image,
  fallback,
  href,
  installPrompt,
}));
---

<Layout
  title="Copilot Extensions by Jon Gallant"
  description="Jon Gallant's (jongio) collection of GitHub Copilot extensions for the Copilot app and CLI."
>
  <header style="text-align: center;">
    <p style="text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 600; color: var(--muted); margin: 0 0 0.5rem;">
      GitHub Copilot · App &amp; CLI
    </p>
    <h1 style="font-size: clamp(2rem, 6vw, 3.25rem); line-height: 1.1; margin: 0 0 0.75rem;">
      Copilot Extensions
    </h1>
    <p style="margin: 0 0 1rem; font-size: 1rem; color: var(--muted);">
      by <a href="https://github.com/jongio" target="_blank" rel="noopener" style="font-weight: 600;">Jon Gallant (jongio)</a>
    </p>
    <p style="font-size: 1.15rem; color: var(--muted); max-width: 52ch; margin: 0 auto 1.5rem;">
      A collection of GitHub Copilot extensions that work in both the Copilot app
      and the Copilot CLI. Most are interactive canvas apps; others just contribute
      agent tools or hooks.
    </p>
    <p style="font-size: 0.95rem; color: var(--muted); margin: 0 0 1.5rem;">
      Tap any extension for a closer look.
    </p>
    <p style="margin: 0 0 2.5rem;">
      <a
        href={repo}
        target="_blank"
        rel="noopener"
        style="text-decoration: none; font-weight: 600;"
      >
        View on GitHub →
      </a>
    </p>
  </header>

  {
    groups.map((g) => {
      const groupItems = items.filter((it) => it.group === g.title);
      return (
        <section class="group">
          <div class="group-head">
            <h2 class="group-title">
              {g.title}
              <span class="group-count">{groupItems.length}</span>
            </h2>
            <p class="group-blurb">{g.blurb}</p>
          </div>
          {g.title === "Copilot CLI Statuslines" && (
            <div class="statusline-showcase">
              <div class="sl-shot-block">
                <div class="sl-trio-banner" aria-label="Three Statusline Types">
                  <span class="sl-trio-item c-pr">Pull Requests</span>
                  <span class="sl-trio-sep" aria-hidden="true">|</span>
                  <span class="sl-trio-item c-issue">Issues</span>
                  <span class="sl-trio-sep" aria-hidden="true">|</span>
                  <span class="sl-trio-item c-sub">Subagents</span>
                </div>
                <div class="sl-shot-wrap" data-full-img={`${base}screenshots/statusline-composed-terminal.png`} role="button" tabindex="0" aria-label="View Composed Statusline infographic full size">
                  <img src={`${base}screenshots/statusline-composed-terminal.png`} alt="Annotated overview of the three Copilot CLI statusline types: Pull Requests, Issues, and Subagents" loading="eager" />
                  <span class="sl-zoom-hint">Click to view full size</span>
                </div>
              </div>

              <div class="sl-install-stack">
                <div class="sl-install-head">
                  <strong>Quick Interactive Setup (Prompts for PRs, Issues, and/or Subagents)</strong>
                  <span><a href={`${base}pr-statusline-doc.html`}>Open full documentation →</a></span>
                </div>
                <div class="sl-install-item">
                  <div class="sl-os-label">Windows (PowerShell one-liner)</div>
                  <div class="code-block">
                    <pre><code>irm https://raw.githubusercontent.com/jongio/copilot-extensions/main/install-statusline.ps1 | iex</code></pre>
                    <button class="code-copy-btn" type="button" data-copy="irm https://raw.githubusercontent.com/jongio/copilot-extensions/main/install-statusline.ps1 | iex" aria-label="Copy Windows command" title="Copy command">
                      <svg class="icon-copy" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path>
                        <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path>
                      </svg>
                      <svg class="icon-check" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="sl-install-item">
                  <div class="sl-os-label">macOS &amp; Linux (Bash one-liner)</div>
                  <div class="code-block">
                    <pre><code>curl -fsSL https://raw.githubusercontent.com/jongio/copilot-extensions/main/install-statusline.sh | bash</code></pre>
                    <button class="code-copy-btn" type="button" data-copy="curl -fsSL https://raw.githubusercontent.com/jongio/copilot-extensions/main/install-statusline.sh | bash" aria-label="Copy macOS and Linux command" title="Copy command">
                      <svg class="icon-copy" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path>
                        <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path>
                      </svg>
                      <svg class="icon-check" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="sl-install-item">
                  <div class="sl-os-label">Ask Copilot CLI (All OSes)</div>
                  <div class="code-block">
                    <pre><code>set up the copilot statusline from jongio/copilot-extensions and ask me whether I want PRs, issues, and/or subagents</code></pre>
                    <button class="code-copy-btn" type="button" data-copy="set up the copilot statusline from jongio/copilot-extensions and ask me whether I want PRs, issues, and/or subagents" aria-label="Copy Copilot prompt" title="Copy prompt">
                      <svg class="icon-copy" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path>
                        <path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path>
                      </svg>
                      <svg class="icon-check" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>

              <div class="sl-infographic-list">

                <div class="sl-shot-block">
                  <div class="sl-shot-header">
                    <div>
                      <strong>1. Pull Request Statusline (<code>pr-statusline</code>) · All States &amp; Icons</strong>
                      <p class="sl-shot-sub">Tracks every pull request this session touches across repositories and worktrees. Each pill is a clickable OSC 8 link to the PR web view.</p>
                    </div>
                    <span><a href={`${repo}/tree/main/extensions/pr-statusline`} target="_blank" rel="noopener">View source →</a></span>
                  </div>
                  <div class="sl-shot-wrap" data-full-img={`${base}screenshots/pr-statusline.png`} role="button" tabindex="0" aria-label="View PR Statusline infographic full size">
                    <img src={`${base}screenshots/pr-statusline.png`} alt="Annotated infographic of pr-statusline showing Green, Amber, Red, and Purple PR pills and explaining each icon" loading="lazy" />
                    <span class="sl-zoom-hint">Click to view full size</span>
                  </div>
                  <div class="sl-legend-grid">
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-link.png`} role="button" tabindex="0" aria-label="View Repo#PR Link up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-link.png`} alt="Up-close screenshot of clickable Repo#PR link token" loading="lazy" />
                      </div>
                      <code>Repo#PR Link</code>
                      <span>Clickable OSC 8 link to <code>owner/repo#number</code> on GitHub (Ctrl+Click or Cmd+Click)</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-ci.png`} role="button" tabindex="0" aria-label="View CI Checks up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-ci.png`} alt="Up-close screenshot of passing, running, and failing CI check tokens" loading="lazy" />
                      </div>
                      <code>CI Checks (X/Y)</code>
                      <span>Passed checks out of total checks (green checkmark when all pass, hourglass when running, red X when any fail)</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-conflict.png`} role="button" tabindex="0" aria-label="View Merge Conflict up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-conflict.png`} alt="Up-close screenshot of merge conflict warning token" loading="lazy" />
                      </div>
                      <code>Merge Conflict</code>
                      <span>Warning triangle shown on red pills when <code>mergeStateStatus === "DIRTY"</code></span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-approvals.png`} role="button" tabindex="0" aria-label="View Approvals up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-approvals.png`} alt="Up-close screenshot of PR approval counter tokens" loading="lazy" />
                      </div>
                      <code>Approvals (X/Y)</code>
                      <span>Thumbs-up icon with approvals received vs total reviewers</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-threads.png`} role="button" tabindex="0" aria-label="View Review Threads up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-threads.png`} alt="Up-close screenshot of PR review thread counter tokens" loading="lazy" />
                      </div>
                      <code>Threads (X/Y)</code>
                      <span>Comment icon with resolved review threads vs total review threads</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/pr-merged.png`} role="button" tabindex="0" aria-label="View Purple Merged PR up-close screenshot">
                        <img src={`${base}screenshots/crops/pr-merged.png`} alt="Up-close screenshot of purple merged PR pill" loading="lazy" />
                      </div>
                      <code>Purple Merged</code>
                      <span>Turns GitHub Merged Purple when landed and auto-dismisses after your next prompt</span>
                    </div>
                  </div>
                </div>

                <div class="sl-shot-block">
                  <div class="sl-shot-header">
                    <div>
                      <strong>2. GitHub Issue Statusline (<code>issue-statusline</code>) · All States &amp; Icons</strong>
                      <p class="sl-shot-sub">Renders a separate clickable pill for each GitHub issue worked on in the active session with priority labels, linked PRs, assignees, and comment counts.</p>
                    </div>
                    <span><a href={`${repo}/tree/main/extensions/issue-statusline`} target="_blank" rel="noopener">View source →</a></span>
                  </div>
                  <div class="sl-shot-wrap" data-full-img={`${base}screenshots/issue-statusline.png`} role="button" tabindex="0" aria-label="View Issue Statusline infographic full size">
                    <img src={`${base}screenshots/issue-statusline.png`} alt="Annotated infographic of issue-statusline showing Green, Amber, Red, and Purple issue pills and explaining each icon" loading="lazy" />
                    <span class="sl-zoom-hint">Click to view full size</span>
                  </div>
                  <div class="sl-legend-grid">
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-link.png`} role="button" tabindex="0" aria-label="View Repo#Issue Link up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-link.png`} alt="Up-close screenshot of clickable Repo#Issue link token" loading="lazy" />
                      </div>
                      <code>Repo#Issue Link</code>
                      <span>Separate clickable OSC 8 link per issue (issue icon for standard issues, bug icon for bug-labeled issues)</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-label.png`} role="button" tabindex="0" aria-label="View Priority Label up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-label.png`} alt="Up-close screenshot of issue priority and bug labels" loading="lazy" />
                      </div>
                      <code>Priority / Label</code>
                      <span>Surfaces the highest-signal label (<code>P0</code>, <code>P1</code>, <code>bug</code>, <code>enhancement</code>) right inside the pill</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-pr.png`} role="button" tabindex="0" aria-label="View Linked Open PR up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-pr.png`} alt="Up-close screenshot of linked open PR indicator icon" loading="lazy" />
                      </div>
                      <code>Linked Open PR</code>
                      <span>PR branch icon shown when an open pull request cross-references or closes the issue</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-assignee.png`} role="button" tabindex="0" aria-label="View Assignee up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-assignee.png`} alt="Up-close screenshot of issue assignee token" loading="lazy" />
                      </div>
                      <code>Assignee</code>
                      <span>User icon with the assigned GitHub handle (green when assigned + active, amber when unassigned)</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-comments.png`} role="button" tabindex="0" aria-label="View Comment Count up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-comments.png`} alt="Up-close screenshot of issue comment count token" loading="lazy" />
                      </div>
                      <code>Comment Count</code>
                      <span>Comment bubble showing total discussion comments on the issue</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/issue-closed.png`} role="button" tabindex="0" aria-label="View Purple Closed Issue up-close screenshot">
                        <img src={`${base}screenshots/crops/issue-closed.png`} alt="Up-close screenshot of purple closed completed issue pill" loading="lazy" />
                      </div>
                      <code>Purple Closed</code>
                      <span>Turns purple when closed as completed during this session and auto-dismisses on your next prompt</span>
                    </div>
                  </div>
                </div>

                <div class="sl-shot-block">
                  <div class="sl-shot-header">
                    <div>
                      <strong>3. Subagent Statusline (<code>subagent-statusline</code>) · Fleet Phases &amp; Counters</strong>
                      <p class="sl-shot-sub">Aggregates background subagents spawned by the current Copilot CLI session into live phase counters so you can see fleet progress at a glance.</p>
                    </div>
                    <span><a href={`${repo}/tree/main/extensions/subagent-statusline`} target="_blank" rel="noopener">View source →</a></span>
                  </div>
                  <div class="sl-shot-wrap" data-full-img={`${base}screenshots/subagent-statusline.png`} role="button" tabindex="0" aria-label="View Subagent Statusline infographic full size">
                    <img src={`${base}screenshots/subagent-statusline.png`} alt="Annotated infographic of subagent-statusline showing active fleet counters and all-merged summary pill with pointer lines" loading="lazy" />
                    <span class="sl-zoom-hint">Click to view full size</span>
                  </div>
                  <div class="sl-legend-grid">
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-icon.png`} role="button" tabindex="0" aria-label="View Subagent Icon up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-icon.png`} alt="Up-close screenshot of subagent fleet icon token" loading="lazy" />
                      </div>
                      <code>Subagent Icon</code>
                      <span>Session fleet tracker (click opens subagent PRs in your browser; run <code>/tasks</code> in console to inspect agents)</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-starting.png`} role="button" tabindex="0" aria-label="View Starting Counter up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-starting.png`} alt="Up-close screenshot of subagents starting counter token" loading="lazy" />
                      </div>
                      <code>N starting</code>
                      <span>Hourglass counter for subagents currently running before opening a pull request</span>
                    </div>
                    <div class="sl-legend-item">
                      <div class="sl-legend-crop" data-full-img={`${base}screenshots/crops/sub-inpr.png`} role="button" tabindex="0" aria-label="View In-PR Counter up-close screenshot">
                        <img src={`${base}screenshots/crops/sub-inpr.png`} alt="Up-close screenshot of subagents in PR counter token" loading="lazy" />
